<section class="drift-review" aria-labelledby="drift-review-title" data-drift-review>
  <div class="review-header">
    <div>
      <p class="review-kicker">Try this check · fictional example</p>
      <h2 id="drift-review-title">Check the second XAUUSD trade</h2>
      <p>Tick each fact that matched the written plan. This helps you review the trade. It does not give a signal.</p>
    </div>
    <span class="review-badge">IST journal</span>
  </div>

  <div class="scenario-line" aria-label="Fictional session sequence">
    <div><span>London</span><strong>Planned liquidity sweep</strong><small>Outcome: −$38</small></div>
    <span class="scenario-arrow" aria-hidden="true">→</span>
    <div class="drift-node"><span>New York</span><strong>Late breakout entry</strong><small>Reason: recover the loss</small></div>
  </div>

  <div class="review-grid">
    <form class="evidence-form">
      <fieldset>
        <legend>What still matched the written plan?</legend>
        <label>
          <input type="checkbox" name="setup" checked />
          <span><strong>Setup label existed</strong><small>“Breakout” was defined in the rulebook.</small></span>
        </label>
        <label>
          <input type="checkbox" name="session" />
          <span><strong>Session matched the plan</strong><small>The plan covered London, not New York.</small></span>
        </label>
        <label>
          <input type="checkbox" name="confirmation" />
          <span><strong>Confirmation was complete</strong><small>The breakout candle had not closed.</small></span>
        </label>
        <label>
          <input type="checkbox" name="reason" />
          <span><strong>The last result did not drive the entry</strong><small>The entry followed the chart plan, not the previous loss.</small></span>
        </label>
        <label>
          <input type="checkbox" name="size" checked />
          <span><strong>Size followed the recorded method</strong><small>No result-driven size change was logged.</small></span>
        </label>
      </fieldset>
    </form>

    <div class="review-output" aria-live="polite">
      <p class="output-label">Review summary</p>
      <div class="meter" aria-hidden="true"><span data-meter></span></div>
      <div class="counts">
        <div><strong data-aligned>2</strong><span>checks matched</span></div>
        <div><strong data-flags>3</strong><span>changes to review</span></div>
      </div>
      <h3 data-output-title>Your plan changed in three places</h3>
      <p data-output-copy>The session, final check, and reason changed after the first result. Record those changes before you look at the outcome.</p>
      <div class="next-review">
        <span>Next comparison</span>
        <p data-next-step>Filter other post-loss entries by session, setup confirmation, and reason for entry.</p>
      </div>
    </div>
  </div>

  <p class="tool-note">There is no universal score for overtrading. Compare the trade with your own written plan and current account rules.</p>
</section>

<script>
  document.querySelectorAll('[data-drift-review]').forEach((tool) => {
    const checks = [...tool.querySelectorAll('input[type="checkbox"]')];
    const aligned = tool.querySelector('[data-aligned]');
    const flags = tool.querySelector('[data-flags]');
    const meter = tool.querySelector('[data-meter]');
    const title = tool.querySelector('[data-output-title]');
    const copy = tool.querySelector('[data-output-copy]');
    const nextStep = tool.querySelector('[data-next-step]');

    const update = () => {
      const alignedCount = checks.filter((check) => check.checked).length;
      const flagCount = checks.length - alignedCount;
      aligned.textContent = String(alignedCount);
      flags.textContent = String(flagCount);
      meter.style.width = `${(alignedCount / checks.length) * 100}%`;

      if (flagCount === 0) {
        title.textContent = 'All five checks match your plan';
        copy.textContent = 'Keep the result separate. Check the record again during your planned review.';
        nextStep.textContent = 'Compare this trade with other trades that used the same setup and session.';
      } else if (flagCount <= 2) {
        title.textContent = 'One or two parts changed';
        copy.textContent = 'Write down what changed. Then check whether the same thing happened in similar trades.';
        nextStep.textContent = 'Filter your journal by the unchecked fields and compare similar trades.';
      } else {
        title.textContent = 'Your plan changed in several places';
        copy.textContent = 'Record the changes before you look at whether the trade won or lost.';
        nextStep.textContent = 'Check other post-loss trades by session, final confirmation, and reason for entry.';
      }
    };

    for (const check of checks) check.addEventListener('change', update);
    update();
  });
</script>

