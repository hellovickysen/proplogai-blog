---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="zoom-figure" data-zoom-root>
  <button class="zoom-trigger" type="button" aria-label={`Open larger image: ${alt}`} data-zoom-trigger>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    <span class="zoom-hint" aria-hidden="true">Click to zoom</span>
  </button>
  {caption && <figcaption>{caption}</figcaption>}

  <dialog class="zoom-dialog" aria-label={`Larger image: ${alt}`} data-zoom-dialog>
    <div class="zoom-panel">
      <button class="zoom-close" type="button" data-zoom-close>Close</button>
      <img src={src} alt={alt} />
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll('[data-zoom-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.zoomReady === 'true') return;
    root.dataset.zoomReady = 'true';

    const trigger = root.querySelector('[data-zoom-trigger]');
    const dialog = root.querySelector('[data-zoom-dialog]');
    const close = root.querySelector('[data-zoom-close]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;

    trigger.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .zoom-figure { margin: 2rem 0; }
  .zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0;
    cursor: zoom-in;
  }
  .zoom-trigger img { display: block; width: 100%; height: auto; margin: 0; border: 0; border-radius: 0; }
  .zoom-hint {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(7, 9, 18, 0.82);
    padding: 0.35rem 0.6rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(8px);
  }
  figcaption { margin-top: 0.6rem; font-size: 0.78rem; line-height: 1.5; color: rgba(255, 255, 255, 0.45); }
  .zoom-dialog {
    width: min(96vw, 1100px);
    max-width: none;
    max-height: 94vh;
    border: 0;
    background: transparent;
    padding: 0;
    overflow: visible;
  }
  .zoom-dialog::backdrop { background: rgba(2, 3, 8, 0.9); backdrop-filter: blur(6px); }
  .zoom-panel { position: relative; display: grid; place-items: center; max-height: 94vh; }
  .zoom-panel img { display: block; max-width: 96vw; max-height: 90vh; margin: 0; border: 0; border-radius: 0.8rem; object-fit: contain; }
  .zoom-close {
    position: absolute;
    z-index: 1;
    top: 0.6rem;
    right: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(7, 9, 18, 0.9);
    padding: 0.45rem 0.7rem;
    color: white;
    cursor: pointer;
  }
  @media (max-width: 520px) {
    .zoom-hint { right: 0.5rem; bottom: 0.5rem; font-size: 0.62rem; }
    figcaption { font-size: 0.72rem; }
  }
</style>
